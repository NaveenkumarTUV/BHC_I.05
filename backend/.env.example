# ============================================================
# BHC Quotation Generator — Environment Configuration
# ============================================================
# Copy this file to the project root as .env and fill in values.
# Lines starting with # are comments and are ignored.
# ============================================================


# Primary input Excel for dashboard workflow (Pending = Excel - DB)
EXCEL_FILE_PATH=

# Optional override for processed-clients SQLite DB location
BHC_PROCESSED_DB_PATH=

# Optional override for shared configuration SQLite DB location
BHC_CONFIG_DB_PATH=

# Bootstrap/recovery password for the seeded admin account.
# Admin email: M.naveenkumar@ind.tuv.com
BHC_ADMIN_PASSWORD=

# ------------------------------------------------------------
# DATA DIRECTORY (optional — advanced)
# ------------------------------------------------------------
# Leave blank to use the default data/ folder inside the project.
DATA_DIR_PATH=

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=7860
DEBUG_MODE=false

# ------------------------------------------------------------
# CORS — Comma-separated allowed origins
# Defaults to http://127.0.0.1:{SERVER_PORT} if blank.
# ------------------------------------------------------------
ALLOWED_ORIGINS=
